@{
    ViewBag.Title = "Pago de Sueldo";
    var id = (int?)Model ?? null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
<link href="~/Estilos/redisenopantallas.css?v=4.0" rel="stylesheet" />
<link href="~/Estilos/Clientes.css?v=1.6" rel="stylesheet" />
<link href="~/Estilos/PagosNuevoModif.css?v=4.1" rel="stylesheet" />

<div class="ve-dark pagos-nm">
    <div class="container-fluid page-99 py-3">

        <section class="cc-header mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="cc-badge pagos-nm-badge">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div>
                        <h2 class="m-0 fw-800">Pago de sueldo</h2>
                        <div class="text-muted-cc">@(id.HasValue ? "Edición de liquidación" : "Nueva liquidación") · Comisiones y pagos</div>
                    </div>
                </div>
                <div class="pagos-nm-actions d-flex flex-wrap gap-2 ms-auto">
                    <a class="btn btn-outline-light pagos-nm-btn" href="~/Pagos/Index">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                    <button type="button" id="btnExportPdf" class="btn btn-outline-success pagos-nm-btn">
                        <i class="bi bi-filetype-pdf me-1"></i> Exportar PDF
                    </button>
                    <button type="button" id="btnOpenReglas" class="btn btn-outline-info pagos-nm-btn">
                        <i class="bi bi-sliders me-1"></i> Reglas
                    </button>
                </div>
            </div>
        </section>

        <div class="pagos-kpi-row d-flex flex-wrap gap-3 mb-4">
            <div class="cc-stat info-box pagos-kpi">
                <div class="label"><i class="bi bi-cash-stack me-1"></i> Importe</div>
                <div class="value" id="sumTotal">$ 0,00</div>
            </div>
            <div class="cc-stat info-box info-ok pagos-kpi">
                <div class="label"><i class="bi bi-check2-circle me-1"></i> Abonado</div>
                <div class="value" id="sumAbonado">$ 0,00</div>
            </div>
            <div class="cc-stat info-box info-warn pagos-kpi">
                <div class="label"><i class="bi bi-hourglass-split me-1"></i> Saldo</div>
                <div class="value" id="sumSaldo">$ 0,00</div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-xl-7">
                <section class="card-glass p-3 mb-3">
                    <div class="pagos-section-title mb-3">
                        <i class="bi bi-calendar3-range me-2"></i> Datos / período
                    </div>
                    <div class="row g-3 align-items-end">
                        <div class="col-12">
                            <label class="pagos-label">Tipo de comisión</label>
                            <div class="segmented" id="segTipo" role="tablist" aria-label="Tipo de comisión">
                                <button type="button" class="segment active" data-tipo="0" role="tab" aria-selected="true">
                                    <i class="bi bi-intersect me-1"></i> Ambos
                                </button>
                                <button type="button" class="segment" data-tipo="1" role="tab" aria-selected="false">
                                    <i class="bi bi-graph-up-arrow me-1"></i> Ventas
                                </button>
                                <button type="button" class="segment" data-tipo="2" role="tab" aria-selected="false">
                                    <i class="bi bi-cash-coin me-1"></i> Cobros
                                </button>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="pagos-label" for="slcTipoNegocio">Tipo de negocio</label>
                            <select id="slcTipoNegocio" class="form-select pagos-input">
                                <option value="-1">Todos</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="pagos-label" for="slcUsuario">Vendedor</label>
                            <select id="slcUsuario" class="form-select pagos-input">
                                <option value="">Seleccionar</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="pagos-label" for="inpDesde">Desde</label>
                            <div class="input-icon">
                                <i class="bi bi-calendar3"></i>
                                <input type="date" id="inpDesde" class="form-control pagos-input" inputmode="numeric">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="pagos-label" for="inpHasta">Hasta</label>
                            <div class="input-icon">
                                <i class="bi bi-calendar3"></i>
                                <input type="date" id="inpHasta" class="form-control pagos-input" inputmode="numeric">
                            </div>
                        </div>

                        <div class="col-12 col-lg-auto">
                            <button type="button" class="btn btn-primary w-100" id="btnCalcular">
                                <i class="bi bi-cpu me-1"></i> Calcular
                            </button>
                        </div>
                        <div class="col-12 col-lg">
                            <label class="pagos-label" for="inpConcepto">Concepto</label>
                            <input type="text" id="inpConcepto" class="form-control pagos-input" placeholder="Ej. Liquidación semanal" maxlength="120">
                        </div>
                        <div class="col-12">
                            <label class="pagos-label" for="inpNota">Nota / observaciones</label>
                            <input type="text" id="inpNota" class="form-control pagos-input" placeholder="Opcional" maxlength="200">
                        </div>
                    </div>
                </section>

                <section class="card-glass mb-3 pagos-table-card">
                    <div class="pagos-section-title px-3 pt-3 mb-2">
                        <i class="bi bi-list-check me-2"></i> Detalle de comisión
                    </div>
                    <div class="table-wrap">
                        <table class="table pagos-table align-middle mb-0" id="tblDetalle">
                            <thead>
                                <tr>
                                    <th style="min-width:160px">Origen</th>
                                    <th style="min-width:200px">Descripción</th>
                                    <th class="text-end">Base</th>
                                    <th class="text-end">%</th>
                                    <th class="text-end">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="empty-row">
                                    <td colspan="5" class="text-center py-5">
                                        <div class="empty">
                                            <i class="bi bi-ui-checks-grid"></i>
                                            <div class="empty-title">Sin detalle</div>
                                            <div class="empty-sub">Calculá para ver los ítems de comisión</div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot class="d-none" id="tfootDetalle">
                                <tr>
                                    <th colspan="2" class="text-end pe-3">Totales</th>
                                    <th></th>
                                    <th></th>
                                    <th class="text-end" id="ftImporte">—</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </section>
            </div>

            <div class="col-xl-5">
                <section class="card-glass p-3 h-100">
                    <div class="pagos-section-title mb-3">
                        <i class="bi bi-speedometer2 me-2"></i> Resumen
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="pill">
                                <i class="bi bi-graph-up-arrow"></i>
                                <span>Comisión por ventas</span>
                                <strong id="sumVentas">$ 0,00</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="pill">
                                <i class="bi bi-cash-coin"></i>
                                <span>Comisión por cobros</span>
                                <strong id="sumCobros">$ 0,00</strong>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mt-4 mb-2">
                        <div class="pagos-section-title mb-0">
                            <i class="bi bi-receipt-cutoff me-1"></i> Pagos registrados
                        </div>
                    </div>

                    <div class="table-wrap small-wrap">
                        <table class="table pagos-table table-sm align-middle mb-0" id="tblPagos">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Método</th>
                                    <th class="text-end">Importe</th>
                                    <th>Nota</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="empty-row">
                                    <td colspan="5" class="text-center py-4">
                                        <div class="empty">
                                            <i class="bi bi-wallet2"></i>
                                            <div class="empty-title">Sin pagos</div>
                                            <div class="empty-sub">Registrá un pago para verlo aquí</div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        <button type="button" id="btnOpenPago" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i> Agregar pago
                        </button>
                    </div>

                    <div class="pagos-firma mt-3">
                        <div class="pagos-section-title mb-2">
                            <i class="bi bi-file-earmark-text me-2"></i> Comprobante / firma
                        </div>
                        <label class="pagos-label">Adjuntar PDF o imagen firmada</label>
                        <label class="file-input w-100" id="firmaWrapper">
                            <input type="file" id="firmaFile" accept="image/*,.pdf">
                            <span class="fake">
                                <i class="bi bi-paperclip"></i>
                                <span class="txt">Seleccionar archivo</span>
                                <span class="name" id="firmaName">Ningún archivo seleccionado</span>
                            </span>
                        </label>
                        <div class="pagos-hint mt-2">Este archivo se adjunta al período completo.</div>

                        <div class="d-none mt-3" id="firmaPreviewWrap">
                            <div class="preview">
                                <img id="firmaPreviewImg" alt="Vista previa" />
                            </div>
                            <a id="comprobanteLink" class="btn btn-outline-light btn-sm d-none mt-2" target="_blank">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Abrir comprobante
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <div class="card-glass p-3 mt-3 pagos-save-bar">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="pagos-hint mb-0">Revisá el detalle y los pagos antes de confirmar la liquidación.</div>
                <button type="button" id="btnRegistrarTodo" class="btn btn-primary btn-lg pagos-nm-btn">
                    <i class="bi bi-check2-circle me-1"></i><span class="txt">Registrar</span>
                </button>
            </div>
        </div>
    </div>

    <div class="modal fade cc-modal-shell pagos-modal" id="modalPago" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog cc-modal-dialog pagos-modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content cc-modal-content">
                <div class="modal-header border-0 pb-0">
                    <div class="cc-modal-head">
                        <div class="cc-modal-icon pagos-nm-badge">
                            <i class="bi bi-credit-card"></i>
                        </div>
                        <div>
                            <h5 class="modal-title mb-0">Registrar pago</h5>
                            <div class="cc-modal-subtitle">Fecha, método e importe del pago</div>
                        </div>
                    </div>
                    <button type="button" class="hd-modal-close" data-bs-dismiss="modal" aria-label="Cerrar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="modal-body pt-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="pagos-label" for="pgFecha">Fecha</label>
                            <input type="date" id="pgFecha" class="form-control pagos-input" inputmode="numeric">
                        </div>
                        <div class="col-md-6">
                            <label class="pagos-label" for="pgMetodo">Método</label>
                            <select id="pgMetodo" class="form-select pagos-input">
                                <option value="EFECTIVO">Efectivo</option>
                                <option value="TRANSFERENCIA">Transferencia</option>
                                <option value="DEPOSITO">Depósito</option>
                                <option value="MERCADOPAGO">MercadoPago</option>
                                <option value="OTROS">Otros</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="pagos-label" for="pgImporte">Importe</label>
                            <div class="input-icon">
                                <i class="bi bi-currency-dollar"></i>
                                <input type="text" id="pgImporte" class="form-control pagos-input money-input" placeholder="0,00" inputmode="decimal" autocomplete="off">
                            </div>
                            <div class="pagos-hint mt-1">Saldo actual: <b id="pgSaldo">$ 0,00</b></div>
                        </div>
                        <div class="col-md-6">
                            <label class="pagos-label" for="pgNota">Nota</label>
                            <input type="text" id="pgNota" class="form-control pagos-input" placeholder="Detalle del pago…">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pagos-modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnRegistrarPago" class="btn btn-primary">
                        <i class="bi bi-check2-circle me-1"></i> Registrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade cc-modal-shell pagos-modal pagos-modal--xl" id="modalReglas" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog cc-modal-dialog pagos-modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content cc-modal-content">
                <div class="modal-header border-0 pb-0">
                    <div class="cc-modal-head">
                        <div class="cc-modal-icon pagos-nm-badge">
                            <i class="bi bi-sliders"></i>
                        </div>
                        <div>
                            <h5 class="modal-title mb-0">Reglas de comisión</h5>
                            <div class="cc-modal-subtitle">Tramos y porcentajes por ventas o cobros</div>
                        </div>
                    </div>
                    <button type="button" class="hd-modal-close" data-bs-dismiss="modal" aria-label="Cerrar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <div class="modal-body pt-3">
                    <div class="rule-toolbar mb-3">
                        <div class="row g-3 align-items-end">
                            <div class="col-lg-4">
                                <label class="pagos-label">Tipo de comisión</label>
                                <div class="segmented" id="segReglaTipo" role="tablist" aria-label="Tipo de comisión para reglas">
                                    <button type="button" class="segment active" data-tipo="1" role="tab" aria-selected="true">
                                        <i class="bi bi-graph-up-arrow me-1"></i> Ventas
                                    </button>
                                    <button type="button" class="segment" data-tipo="2" role="tab" aria-selected="false">
                                        <i class="bi bi-cash-coin me-1"></i> Cobros
                                    </button>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <label class="pagos-label" for="rgTipoNegocio">Tipo de negocio</label>
                                <select id="rgTipoNegocio" class="form-select pagos-input">
                                    <option value="">Todos</option>
                                </select>
                            </div>
                            <div class="col-lg-4 d-flex justify-content-lg-end">
                                <button type="button" id="btnNuevaRegla" class="btn btn-success w-100 w-lg-auto">
                                    <i class="bi bi-plus-lg me-1"></i> Nueva regla
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="table-wrap table-wrap-rules">
                        <table class="table pagos-table align-middle mb-0" id="tblReglas">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Tipo negocio</th>
                                    <th class="text-end">Desde</th>
                                    <th class="text-end">Hasta</th>
                                    <th class="text-end">% Comisión</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <div id="reglaEditor" class="rule-editor d-none">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="pagos-label" for="edDesde">Monto desde</label>
                                <div class="input-icon">
                                    <i class="bi bi-currency-dollar"></i>
                                    <input type="text" id="edDesde" class="form-control pagos-input money-input" placeholder="0" inputmode="decimal">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="pagos-label" for="edHasta">Monto hasta</label>
                                <div class="input-icon">
                                    <i class="bi bi-currency-dollar"></i>
                                    <input type="text" id="edHasta" class="form-control pagos-input money-input" placeholder="0 (ilimitado)" inputmode="decimal">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="pagos-label" for="edPorc">% Comisión</label>
                                <div class="input-icon">
                                    <i class="bi bi-percent"></i>
                                    <input type="text" id="edPorc" class="form-control pagos-input" placeholder="0" inputmode="decimal">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="edActiva" checked>
                                    <label class="form-check-label" for="edActiva">Activa</label>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" id="btnGuardarRegla" class="btn btn-primary">Guardar</button>
                                    <button type="button" id="btnCancelarRegla" class="btn btn-outline-light">Cancelar</button>
                                </div>
                            </div>
                        </div>
                        <div class="pagos-hint mt-2">
                            Las reglas se aplican por tramos sobre el monto final del ítem (venta o cobro).
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="imgLightbox">
        <span class="close">&times;</span>
        <img id="imgLightboxImg" src="" alt="Vista ampliada" />
    </div>
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>window.PAGOS_ID_SUELDO = @(id.HasValue ? id.Value : 0);</script>
    <script src="~/JavaScript/pagosnuevomodif.js?v=3.9"></script>
}
