                    <div class="hd-state hd-state--loading" id="hdEstadoCarga">
                        <div class="hd-skeleton-card"></div>
                        <div class="hd-skeleton-card"></div>
                        <div class="hd-skeleton-card hd-skeleton-card--short"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 hd-modal-footer">
                <button type="button" class="btn btn-outline-light hd-btn-cerrar" data-bs-dismiss="modal">
                    <i class="fa fa-times-circle-o me-1"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>
