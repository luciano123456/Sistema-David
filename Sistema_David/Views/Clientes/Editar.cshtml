@{
    ViewBag.Title = "Cliente";
}

<link href="~/Content/Datatable/css/jquery.dataTables.min.css" rel="stylesheet" />
<link href="~/Estilos/redisenopantallas.css?v=4.0" rel="stylesheet" />
<link href="~/Estilos/Clientes.css?v=1.6" rel="stylesheet" />
<link href="~/Estilos/ClientesEditar.css?v=4.2" rel="stylesheet" />
<link href="~/Content/Datatable/css/responsive.dataTables.min.css" rel="stylesheet" />
<link href="~/Content/font-awesome.css" rel="stylesheet" />

<div class="ve-dark clientes-editar-root">

    @if (@ViewData["ErrorPermisos"] == null)
    {
        <div class="container-fluid page-99 ce-page">

            <section class="cc-header ce-top">
                <div class="ce-top-row">
                    <div class="ce-top-id">
                        <div class="cc-badge ce-badge-edit">
                            <i class="fa fa-user-circle"></i>
                        </div>
                        <div class="ce-top-titles">
                            <h2 class="m-0 fw-800" id="cePageTitle">Cliente</h2>
                            <div class="text-muted-cc" id="cePageSubtitle">Datos, ubicaci&oacute;n y l&iacute;mite de ventas</div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-light ce-btn-back" onclick="volverListadoClientes()">
                        <i class="fa fa-arrow-left me-1"></i> Volver
                    </button>
                </div>
            </section>

            <div class="ce-ficha card-glass">
                <div class="ce-ficha-grid">
                    <div class="ce-ficha-form">
                        <div id="ceFormAlert" class="ce-form-alert" hidden role="alert">
                            <i class="fa fa-exclamation-circle" aria-hidden="true"></i>
                            <span id="ceFormAlertText">Revis&aacute; los campos marcados en rojo.</span>
                        </div>

                        <section class="ce-block">
                            <div class="ce-section-head">
                                <i class="fa fa-id-card-o"></i>
                                <span>Datos personales</span>
                                <span class="ce-section-tag">Paso 1</span>
                            </div>
                            <p class="ce-section-lead">Nombre, apellido y tel&eacute;fono son obligatorios. En un cliente nuevo tambi&eacute;n el segundo celular. El tel&eacute;fono principal se usa para WhatsApp.</p>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <div class="ce-field" data-field="Nombre">
                                        <label class="form-label" for="Nombre">
                                            Nombre <abbr class="ce-req" title="Obligatorio">*</abbr>
                                        </label>
                                        <input id="Nombre" type="text" class="form-control ce-input" placeholder="Ej: Sergio" autocomplete="given-name" autocapitalize="words" aria-required="true" aria-describedby="errNombre" />
                                        <span id="errNombre" class="ce-field-msg" hidden></span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="ce-field" data-field="Apellido">
                                        <label class="form-label" for="Apellido">
                                            Apellido <abbr class="ce-req" title="Obligatorio">*</abbr>
                                        </label>
                                        <input id="Apellido" type="text" class="form-control ce-input" placeholder="Ej: Rivero" autocomplete="family-name" autocapitalize="words" aria-required="true" aria-describedby="errApellido" />
                                        <span id="errApellido" class="ce-field-msg" hidden></span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="ce-field" data-field="Dni">
                                        <label class="form-label" for="Dni">DNI</label>
                                        <input id="Dni" type="text" class="form-control ce-input" placeholder="Ej: 30123456" inputmode="numeric" autocomplete="off" aria-describedby="errDni" />
                                        <span id="errDni" class="ce-field-msg" hidden></span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="ce-field" data-field="Telefono">
                                        <label class="form-label" for="Telefono">
                                            Tel&eacute;fono / WhatsApp <abbr class="ce-req" title="Obligatorio">*</abbr>
                                        </label>
                                        <input id="Telefono" type="tel" class="form-control ce-input" placeholder="Ej: 3794 123456" inputmode="tel" autocomplete="tel" maxlength="20" aria-required="true" aria-describedby="errTelefono" />
                                        <span id="errTelefono" class="ce-field-msg" hidden></span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="ce-field" data-field="Telefono2">
                                        <label class="form-label" for="Telefono2">
                                            Segundo celular <abbr class="ce-req" id="reqTelefono2" title="Obligatorio al registrar" hidden>*</abbr>
                                        </label>
                                        <input id="Telefono2" type="tel" class="form-control ce-input" placeholder="Ej: 3795 654321" inputmode="tel" autocomplete="off" maxlength="20" aria-describedby="errTelefono2" />
                                        <span id="errTelefono2" class="ce-field-msg" hidden></span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="ce-block">
                            <div class="ce-section-head">
                                <i class="fa fa-briefcase"></i>
                                <span>Datos comerciales</span>
                                <span class="ce-section-tag">Paso 2</span>
                            </div>
                            <p class="ce-section-lead">Asign&aacute; vendedor, zona y tope de ventas. El estado define si puede operar.</p>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <div class="ce-field" data-field="Usuarios">
                                        <label class="form-label" for="Usuarios">Vendedor</label>
                                        <select id="Usuarios" name="select" class="form-select ce-input" aria-describedby="errUsuarios">
                                            <option value="" selected>Seleccion&aacute; vendedor</option>
                                        </select>
                                        <span id="errUsuarios" class="ce-field-msg" hidden></span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="ce-field" data-field="Zonas">
                                        <label class="form-label" for="Zonas">Zona</label>
                                        <select id="Zonas" name="select" class="form-select ce-input" aria-describedby="errZonas">
                                            <option value="" selected>Seleccion&aacute; zona</option>
                                        </select>
                                        <span id="errZonas" class="ce-field-msg" hidden></span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="ce-field" data-field="Estados">
                                        <label class="form-label" for="Estados">Estado</label>
                                        <select id="Estados" name="select" class="form-select ce-input" aria-describedby="errEstados">
                                            <option value="" selected>Seleccion&aacute; estado</option>
                                        </select>
                                        <span id="errEstados" class="ce-field-msg" hidden></span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="ce-field" data-field="LimiteVentas">
                                        <label class="form-label" for="LimiteVentas">L&iacute;mite de ventas</label>
                                        <div class="input-group ce-input-group">
                                            <span class="input-group-text">$</span>
                                            <input id="LimiteVentas" type="text" class="form-control ce-input" placeholder="0" inputmode="numeric" autocomplete="off" aria-describedby="errLimiteVentas" />
                                        </div>
                                        <span id="errLimiteVentas" class="ce-field-msg" hidden></span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="ce-block">
                            <div class="ce-section-head">
                                <i class="fa fa-map-marker"></i>
                                <span>Ubicaci&oacute;n</span>
                                <span class="ce-section-tag">Paso 3</span>
                                <button type="button" id="btnHistorialDireccionEdicion" class="hd-trigger-eye hd-trigger-eye--label ms-auto" title="Ver historial de direcci&oacute;n" onclick="abrirHistorialDireccionClienteDesdeEdicion()" hidden>
                                    <i class="fa fa-eye"></i>
                                </button>
                            </div>
                            <p class="ce-section-lead">Escrib&iacute; la direcci&oacute;n o us&aacute; el mapa: al mover el pin se actualizan las coordenadas.</p>
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="ce-field" data-field="Direccion">
                                        <label class="form-label" for="Direccion">Direcci&oacute;n</label>
                                        <input id="Direccion" type="text" class="form-control ce-input" placeholder="Calle, n&uacute;mero, localidad" autocomplete="street-address" aria-describedby="errDireccion" />
                                        <span id="errDireccion" class="ce-field-msg" hidden></span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="ce-coords">
                                        <div class="ce-coord-group">
                                            <span class="ce-coord-prefix">Lat</span>
                                            <span id="lbllatitud" class="ce-coord-value">&mdash;</span>
                                        </div>
                                        <div class="ce-coord-group">
                                            <span class="ce-coord-prefix">Long</span>
                                            <span id="lbllongitud" class="ce-coord-value">&mdash;</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="ce-block ce-block--adj">
                            <div class="ce-section-head">
                                <i class="fa fa-paperclip"></i>
                                <span>Documentos e im&aacute;genes</span>
                                <span class="ce-section-tag ce-section-tag--opt">Opcional</span>
                                <span id="ceAdjCount" class="ce-adj-count">0</span>
                            </div>
                            <p class="ce-adj-lead">DNI, comprobantes o lo que necesites. Pod&eacute;s adjuntar todas las que quieras: quedan en la ficha de este cliente.</p>
                            <div id="ceAdjDrop" class="ce-adj-drop" tabindex="0">
                                <input id="ceAdjInput" type="file" accept="image/*,.pdf,application/pdf" multiple hidden />
                                <div class="ce-adj-drop-icon"><i class="fa fa-cloud-upload"></i></div>
                                <div class="ce-adj-drop-title">Arrastr&aacute; las fotos ac&aacute; o toc&aacute; para elegirlas</div>
                                <div class="ce-adj-drop-sub">JPG, PNG o PDF. Las fotos se comprimen al guardarlas.</div>
                            </div>
                            <div id="ceAdjEstado" class="ce-adj-estado" hidden></div>
                            <div id="ceAdjGrid" class="ce-adj-grid"></div>
                        </section>
                    </div>

                    <div class="ce-ficha-map">
                        <div class="ce-map-head">
                            <div class="ce-section-head ce-section-head--map">
                                <i class="fa fa-globe"></i>
                                <span>Mapa de ubicaci&oacute;n</span>
                            </div>
                            <p class="ce-map-hint">Busc&aacute; la direcci&oacute;n o arrastr&aacute; el pin para actualizar coordenadas.</p>
                        </div>
                        <div class="ce-map-frame">
                            <div class="ce-map-search" id="ceMapSearch">
                                <span class="ce-map-search-ico" aria-hidden="true"><i class="fa fa-search"></i></span>
                                <input id="pac-input" class="ce-pac-input" type="text" placeholder="Buscar en Google Maps" autocomplete="off" />
                            </div>
                            <div class="ce-map-wrap">
                                <div id="map"></div>
                            </div>
                        </div>
                        <ul id="location-list" class="ce-location-list"></ul>
                        <div class="ce-map-tools d-none">
                            <button type="button" class="btn btn-sm btn-outline-light" id="borrar-recorrido" onclick="armarRecorrido()">Iniciar recorrido</button>
                            <button type="button" class="btn btn-sm btn-outline-light" id="ir" onclick="irAUbicacion()" hidden>Ir</button>
                            <button type="button" class="btn btn-sm btn-outline-light" id="siguiente" onclick="siguienteUbicacion()" hidden>Siguiente</button>
                            <button type="button" class="btn btn-sm btn-outline-light" id="finalizar-recorrido" onclick="finalizarRecorrido()" hidden>Finalizar recorrido</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ce-actions-bar card-glass">
                <div class="ce-actions-bar-text text-muted-cc">
                    <i class="fa fa-asterisk ce-req me-1" aria-hidden="true"></i> Nombre, apellido y tel&eacute;fono son obligatorios. El segundo celular, solo al registrar.
                </div>
                <div class="ce-actions">
                    <button type="button" class="btn btn-outline-light ce-btn-cancel" onclick="AccionBtnCancelar()">
                        <i class="fa fa-times me-1"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-primary ce-btn-save" id="btnRegistrarModificar" onclick="AccionBtn()">
                        <i class="fa fa-check me-1"></i> Guardar
                    </button>
                </div>
            </div>

            <label id="lblEstados" class="lblNombreInput" hidden>Estado</label>
            <span id="lbldireccion" hidden></span>
            <span id="IdCliente" hidden></span>

            @Html.Partial("_HistorialDireccionModal")

            <div id="ceAdjLightbox" class="ce-adj-lightbox" hidden>
                <button type="button" class="ce-adj-lightbox-close" id="ceAdjLightboxClose" aria-label="Cerrar">&times;</button>
                <img id="ceAdjLightboxImg" alt="" />
                <div id="ceAdjLightboxCaption" class="ce-adj-lightbox-caption"></div>
            </div>
        </div>
    }
    else
    {
        <div class="container page-99 py-5">
            <div class="card-glass p-4 text-center">
                <h2 class="text-danger m-0">No ten&eacute;s permisos para acceder a esta pantalla</h2>
            </div>
        </div>
    }

</div>

@section scripts {
    <script src="~/Content/Datatable/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/Datatable/js/dataTables.responsive.min.js"></script>
    <script src="~/Scripts/xlsx.full.min.js.js"></script>
    <script src="~/JavaScript/Utils/Utils.js?v=3.21"></script>
    <script src="~/JavaScript/ClientesHistorialDireccion.js?v=1.4" charset="utf-8"></script>
    <script src="~/JavaScript/ClientesAdjuntos.js?v=1.2" charset="utf-8"></script>
    <script src="~/JavaScript/ClientesEditar.js?v=3.1"></script>
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAddgDLrXa7JLbrOCGrCIBqkEDEBh6YtOQ&libraries=places&callback=initMap"></script>
}
