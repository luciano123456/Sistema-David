@{
    ViewBag.Title = "Cobranzas";
}

<link href="~/Content/Datatable/css/jquery.dataTables.min.css" rel="stylesheet" />
<link href="~/Content/Datatable/css/responsive.dataTables.min.css" rel="stylesheet" />
<link href="~/Estilos/redisenopantallas.css?v=4.0" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Estilos/Cobranzas.css?v=2.8" rel="stylesheet" />
<link href="~/Content/font-awesome.css" rel="stylesheet" />

@if (ViewData["ErrorPermisos"] == null)
{
    <div class="ve-dark cb-root">

        <div class="container-fluid page-99 py-3">

            <section class="cc-header mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="cc-badge cb-badge">
                            <i class="fa fa-money"></i>
                        </div>
                        <div>
                            <h2 class="m-0 fw-800">Cobranzas</h2>
                            <div class="text-muted-cc">Cobros de indumentaria</div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 ms-auto">
                        <button type="button" class="btn btn-outline-light btn-sm cb-header-btn" id="btnToggleFiltrosCb" onclick="toggleFiltrosCobranzas()">
                            <i class="fa fa-filter me-1"></i> Filtros
                        </button>
                    </div>
                </div>
            </section>

            <div class="cb-kpi-row d-flex flex-wrap justify-content-center gap-3 mb-4">
                <div class="cc-stat cb-kpi-card cb-kpi-saldo" id="divSaldo" hidden>
                    <div class="label"><i class="fa fa-wallet me-1"></i> Saldo cliente</div>
                    <div class="value" id="totsaldo">—</div>
                </div>
                <div class="cc-stat cb-kpi-card cb-kpi-limite" id="divLimite" hidden>
                    <div class="label"><i class="fa fa-line-chart me-1"></i> L&iacute;mite</div>
                    <div class="value" id="totLimite">—</div>
                </div>
            </div>

            <section id="Filtros" class="card-glass p-3 mb-4 cb-filters-card">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="cb-filter-label" id="lblvendedor" for="Vendedores">Vendedor</label>
                        <select id="Vendedores" name="select" class="form-select cb-filter-input">
                            <option value="" selected>Vendedor</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="cb-filter-label" id="lblcobrador" for="CobradorFiltro">Cobrador</label>
                        <select id="CobradorFiltro" name="select" class="form-select cb-filter-input">
                            <option value="" selected>Cobrador</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="cb-filter-label" for="Zonas">Zona</label>
                        <select id="Zonas" name="select" class="form-select cb-filter-input">
                            <option value="" selected>Zona</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="cb-filter-label" for="TurnoFiltro">Turno</label>
                        <select id="TurnoFiltro" name="select" class="form-select cb-filter-input">
                            <option value="" selected>Turno</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="cb-filter-label" for="TipoNegocio">Tipo de negocio</label>
                        <select id="TipoNegocio" name="select" class="form-select cb-filter-input">
                            <option value="" selected>Tipo de Negocio</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="cb-filter-label" id="lbldninombre" for="Dni">DNI o nombre</label>
                        <input type="text" placeholder="Buscar cliente…" id="Dni" class="form-control cb-filter-input" />
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="cb-filter-label" id="lblfechacobrodesde" for="FechaCobroDesde" hidden>Fecha cobro desde</label>
                        <input type="date" id="FechaCobroDesde" class="form-control cb-filter-input" hidden />
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="cb-filter-label" id="lblfechacobrohasta" for="FechaCobroHasta" hidden>Fecha cobro hasta</label>
                        <input type="date" id="FechaCobroHasta" class="form-control cb-filter-input" hidden />
                    </div>
                    <div class="col-12 col-lg-6 d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-primary flex-fill" id="aplicarFiltros" onclick="aplicarFiltros()">
                            <i class="fa fa-search me-1"></i> Aplicar
                        </button>
                        <button type="button" class="btn btn-outline-light flex-fill" onclick="limpiarFiltrosCobranzas()">
                            <i class="fa fa-eraser me-1"></i> Limpiar
                        </button>
                    </div>
                </div>
            </section>

            <section class="card-glass p-3 mb-4 cb-table-panel">
                <div class="cb-toolbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div class="fw-bold text-white">
                        <i class="fa fa-list-alt me-2"></i> Cartera de cobranzas
                        <span class="cb-count-badge ms-2" id="cbCountBadge">0</span>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 cb-toolbar-actions">
                        <button type="button"
                                class="btn btn-outline-light btn-sm cb-clear-filters-btn"
                                id="btnLimpiarFiltrosColumnasCobranzas"
                                title="Limpiar filtros de columnas">
                            <i class="fa fa-eraser me-1"></i> Limpiar filtros
                        </button>
                        <label class="cb-select-all mb-0">
                            <input type="checkbox" id="selectAllCheckbox" class="form-check-input me-2" />
                            Seleccionar todos
                        </label>
                        <div class="dropdown cb-toolbar-dropdown">
                            <button class="btn btn-outline-light btn-sm cb-columns-toggle d-flex align-items-center" type="button" id="dropdownColumnas" aria-expanded="false">
                                <i class="fa fa-cog me-2"></i> Config. columnas
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end cc-dropdown-menu" aria-labelledby="dropdownColumnas" id="configColumnasMenu"></ul>
                        </div>
                    </div>
                </div>

                <p class="cb-dt-hint d-lg-none text-muted small mb-2">
                    <i class="fa fa-arrows-h me-1"></i> Desliz&aacute; horizontalmente para ver todas las columnas y filtros.
                </p>

                <div class="dt-dark-wrap tabla-wrap cb-table-wrap vc-cobros-dt">
                    <table class="display nowrap w-100 dt-dark" id="grdCobranzas">
                        <thead>
                            <tr>
                                <th class="text-center">Orden</th>
                                <th class="text-center">Cliente</th>
                                <th class="text-center">Direccion</th>
                                <th class="text-center">Cuota</th>
                                <th class="text-center">Entrega</th>
                                <th class="text-center">Restante</th>
                                <th class="text-center">Cobro</th>
                                <th class="text-center">Vencimiento</th>
                                <th class="text-center">V</th>
                                <th class="text-center">C</th>
                                <th class="text-center">T</th>
                                <th class="text-center">F.H</th>
                                <th class="text-center">Zona</th>
                                <th class="text-center">Acciones</th>
                                <th class="text-center cb-col-enrecorrido" hidden>EnRecorrido</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>

            <section class="card-glass p-3 mb-4 cb-table-panel" id="grdCobranzasPendientesDiv" hidden>
                <div class="cb-toolbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div class="fw-bold text-warning">
                        <i class="fa fa-clock-o me-2"></i> Cobranzas pendientes
                    </div>
                </div>
                <div class="dt-dark-wrap tabla-wrap cb-table-wrap vc-cobros-dt">
                    <table class="display nowrap w-100 dt-dark" id="grdCobranzasPendientes">
                        <thead>
                            <tr>
                                <th class="text-center">Orden</th>
                                <th class="text-center">Cliente</th>
                                <th class="text-center">Direccion</th>
                                <th class="text-center">Cuota</th>
                                <th class="text-center">Entrega</th>
                                <th class="text-center">Restante</th>
                                <th class="text-center">Cobro</th>
                                <th class="text-center">Vencimiento</th>
                                <th class="text-center">V</th>
                                <th class="text-center">C</th>
                                <th class="text-center">T</th>
                                <th class="text-center">F.H</th>
                                <th class="text-center">Zona</th>
                                <th class="text-center">Acciones</th>
                                <th class="text-center cb-col-enrecorrido" hidden>EnRecorrido</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>

            <div class="cb-actions-bar d-flex flex-wrap justify-content-end gap-2 mb-4">
                <div id="btnCuentaBancaria" style="display: none">
                    <button type="button" class="btn cb-action-btn cb-action-bank" onclick="abrirModalCuentasBancarias()">
                        <i class="fa fa-university me-1"></i> Cuentas bancarias
                    </button>
                </div>
                <div id="btnAsignarTurno" style="display: none;">
                    <button type="button" class="btn cb-action-btn cb-action-turno" onclick="abrirmodalTurno()">
                        <i class="fa fa-clock-o me-1"></i> Asignar turno
                    </button>
                </div>
                <div id="btnAsignarCobrador" style="display: none;">
                    <button type="button" class="btn cb-action-btn cb-action-cobrador" onclick="abrirmodalCobrador()">
                        <i class="fa fa-user me-1"></i> Asignar cobrador
                    </button>
                </div>
                <div id="btnFinalizarRecorrido">
                    <button type="button" class="btn cb-action-btn cb-action-recorrido" onclick="borrarRecorrido()">
                        <i class="fa fa-map-marker me-1"></i> Finalizar recorrido
                    </button>
                </div>
                <div id="btnArmarRecorrido">
                    <button type="button" class="btn cb-action-btn cb-action-recorrido" onclick="armarRecorrido()">
                        <i class="fa fa-road me-1"></i> Armar recorrido
                    </button>
                </div>
            </div>

        </div>
    </div>
}
else
{
    <div class="ve-dark cb-root py-5 text-center">
        <h2 class="text-danger">Error: No tienes permisos para acceder a esta pantalla</h2>
    </div>
}

    <div class="modal fade cb-modal-shell centered-modal-importar" id="modalHomeCobranza" tabindex="-1" aria-labelledby="modalHomeCobranzaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cb-modal-content">
                <div class="modal-header cb-modal-header border-0">
                    <div class="cb-modal-head">
                        <div class="cb-modal-icon"><i class="fa fa-home"></i></div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="modalHomeCobranzaLabel">Observacion de Cobro</h5>
                    </div>
                    <button type="button" class="cb-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="fa fa-times"></i></button>
                </div>
                <div class="modal-body cb-modal-body">
                    <input type="Text" id="idVentaHome" class="input-nuevomodif" hidden />
                    <label for="mensajeobs" class="cb-field-label">Detalle</label>
                    <input type="Text" placeholder="Detalla informacion del mismo..." id="mensajeobs" class="input-whatssap form-control" />
                    <p id="datos" class="mb-0 mt-2 text-center text-danger datos-error d-none"></p>
                </div>
                <div class="modal-footer cb-modal-footer border-0">
                    <button type="button" class="btn btn-outline-light btnaccion" data-bs-dismiss="modal">Cerrar</button>
                    <button id="btnRegistrarModificar" type="button" class="btn btn-primary cb-btn-cobrar btnaccion" onclick="estadoHome()">Enviar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade cb-modal-shell centered-modal-importar" id="modalWhatssap" tabindex="-1" aria-labelledby="modalWhatssapLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cb-modal-content">
                <div class="modal-header cb-modal-header border-0">
                    <div class="cb-modal-head">
                        <div class="cb-modal-icon"><i class="fa fa-whatsapp"></i></div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="modalWhatssapLabel">Enviar mensaje por WhatsApp</h5>
                    </div>
                    <button type="button" class="cb-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="fa fa-times"></i></button>
                </div>
                <div class="modal-body cb-modal-body">
                    <input type="Text" id="idClienteWhatssap" class="input-nuevomodif" hidden />
                    <label for="mensajewsp" class="cb-field-label">Mensaje</label>
                    <input type="Text" placeholder="Escribe el mensaje" id="mensajewsp" class="input-whatssap form-control" />
                    <p id="datos" class="mb-0 mt-2 text-center text-danger datos-error d-none"></p>
                </div>
                <div class="modal-footer cb-modal-footer border-0">
                    <button type="button" class="btn btn-outline-light btnaccion" data-bs-dismiss="modal">Cerrar</button>
                    <button id="btnRegistrarModificar" type="button" class="btn btn-primary cb-btn-cobrar btnaccion" onclick="enviarWhatssap()">Enviar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade cb-modal-shell centered-modal-importar" id="modalCobradores" tabindex="-1" aria-labelledby="modalCobradoresLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cb-modal-content">
                <div class="modal-header cb-modal-header border-0">
                    <div class="cb-modal-head">
                        <div class="cb-modal-icon"><i class="fa fa-user"></i></div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="modalCobradorespLabel">Asignar Cobrador</h5>
                    </div>
                    <button type="button" class="cb-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="fa fa-times"></i></button>
                </div>
                <div class="modal-body cb-modal-body">
                    <label class="cb-field-label" for="Cobrador">Cobrador</label>
                    <select id="Cobrador" name="select" class="input-nuevomodif select-modal-personalizado form-select">
                        <option value="" selected>Seleccione Cobrador</option>
                    </select>
                    <p id="datos" class="mb-0 mt-2 text-center text-danger datos-error d-none"></p>
                </div>
                <div class="modal-footer cb-modal-footer border-0">
                    <button type="button" class="btn btn-outline-light btnaccion" data-bs-dismiss="modal">Cerrar</button>
                    <button id="btnRegistrarModificar" type="button" class="btn btn-primary cb-btn-cobrar btnaccion" onclick="asignarCobrador()">Asignar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade cb-modal-shell centered-modal-importar" id="modalTurnos" tabindex="-1" aria-labelledby="modalTurnosLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cb-modal-content">
                <div class="modal-header cb-modal-header border-0">
                    <div class="cb-modal-head">
                        <div class="cb-modal-icon"><i class="fa fa-clock-o"></i></div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="modalTurnospLabel">Asignar Turno</h5>
                    </div>
                    <button type="button" class="cb-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="fa fa-times"></i></button>
                </div>
                <div class="modal-body cb-modal-body">
                    <label class="cb-field-label" for="Turno">Turno</label>
                    <select id="Turno" name="select" class="input-nuevomodif select-modal-personalizado form-select">
                        <option value="" selected>Seleccione Turno</option>
                    </select>
                    <p id="datos" class="mb-0 mt-2 text-center text-danger datos-error d-none"></p>
                </div>
                <div class="modal-footer cb-modal-footer border-0">
                    <button type="button" class="btn btn-outline-light btnaccion" data-bs-dismiss="modal">Cerrar</button>
                    <button id="btnRegistrarModificar" type="button" class="btn btn-primary cb-btn-cobrar btnaccion" onclick="asignarTurno()">Asignar</button>
                </div>
            </div>
        </div>
    </div>

