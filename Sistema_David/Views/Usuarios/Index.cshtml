@{
    ViewBag.Title = "Usuarios";
}

<link href="~/Content/Datatable/css/jquery.dataTables.min.css" rel="stylesheet" />
<link href="~/Estilos/redisenopantallas.css?v=4.0" rel="stylesheet" />
<link href="~/Estilos/Clientes.css?v=1.6" rel="stylesheet" />
<link href="~/Estilos/Ventas_Electrodomesticos.css?v=1.8" rel="stylesheet" />
<link href="~/Estilos/Usuarios.css?v=2.4" rel="stylesheet" />
<link href="~/Content/font-awesome.css" rel="stylesheet" />

<div class="ve-dark usuarios-root">

    @if (@ViewData["ErrorPermisos"] == null)
    {
        <div class="container-fluid page-99 py-3">

            <section class="cc-header mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="cc-badge usuarios-badge">
                            <i class="fa fa-user-circle"></i>
                        </div>
                        <div>
                            <h2 class="m-0 fw-800">Usuarios</h2>
                            <div class="text-muted-cc">
                                Gesti&oacute;n de cuentas, roles y accesos al sistema
                            </div>
                        </div>
                    </div>
                    <div class="usuarios-header-actions d-flex flex-wrap gap-2 ms-auto">
                        <button type="button" class="btn btn-outline-info usuarios-header-btn" onclick="abrirstockGeneral()">
                            <i class="fa fa-cubes me-1"></i>
                            <span class="d-none d-sm-inline">Stock general</span>
                            <span class="d-inline d-sm-none">General</span>
                        </button>
                        <button type="button" class="btn btn-outline-warning usuarios-header-btn" onclick="abrirstockPendiente()">
                            <i class="fa fa-clock-o me-1"></i>
                            <span class="d-none d-sm-inline">Stock pendiente</span>
                            <span class="d-inline d-sm-none">Pendiente</span>
                        </button>
                        <button type="button" class="btn btn-primary usuarios-header-btn" onclick="abrirmodal()">
                            <i class="fa fa-plus me-1"></i> Nuevo
                        </button>
                    </div>
                </div>
            </section>

            <div class="card-glass p-3 mb-4 usuarios-table-card">
                <div class="usuarios-table-toolbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div class="fw-bold text-white">
                        <i class="fa fa-table me-2"></i> Listado de usuarios
                    </div>
                    <div class="d-flex flex-wrap gap-2 ms-auto usuarios-toolbar-actions">
                        <button type="button" class="btn btn-outline-light usuarios-clear-filters-btn" onclick="limpiarFiltrosColumnasUsuarios()" title="Limpiar filtros de columnas">
                            <i class="fa fa-eraser me-1"></i> Limpiar filtros
                        </button>
                        <div class="dropdown usuarios-toolbar-dropdown">
                            <button class="btn btn-outline-light usuarios-columns-toggle d-flex align-items-center" type="button" id="dropdownColumnas" aria-expanded="false">
                                <i class="fa fa-cog me-2"></i> Config. columnas
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end cc-dropdown-menu" aria-labelledby="dropdownColumnas" id="configColumnasMenu"></ul>
                        </div>
                    </div>
                </div>

                <p class="usuarios-dt-hint d-lg-none text-muted small mb-2">
                    <i class="fa fa-arrows-h me-1"></i> Desliz&aacute; horizontalmente para ver todas las columnas y filtros.
                </p>

                <div class="table-responsive dt-dark-wrap usuarios-dt-wrap vc-cobros-dt">
                    <table class="display nowrap dt-dark ve-table-cobros w-100" id="grdUsuarios">
                        <thead>
                            <tr>
                                <th class="text-center">Usuario</th>
                                <th class="text-center">Nombre</th>
                                <th class="text-center">Apellido</th>
                                <th class="text-center">Telefono</th>
                                <th class="text-center">Direccion</th>
                                <th class="text-center">Tipo Negocio</th>
                                <th class="text-center">Rol</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container-fluid page-99 py-3">
            <div class="alert alert-danger mb-0">Error: No tienes permisos para acceder a esta pantalla</div>
        </div>
    }

    <!-- Modal usuario -->
    <div class="modal fade cc-modal-shell usuarios-modal" id="usuarioModal" tabindex="-1" aria-labelledby="usuarioModalLabel" aria-hidden="true">
        <div class="modal-dialog cc-modal-dialog usuarios-modal-dialog modal-dialog-centered modal-fullscreen-sm-down modal-dialog-scrollable">
            <div class="modal-content cc-modal-content">
                <div class="modal-header border-0 pb-0">
                    <div class="cc-modal-head">
                        <div class="cc-modal-icon cc-modal-icon--usuarios">
                            <i class="fa fa-user-plus"></i>
                        </div>
                        <div>
                            <h5 class="modal-title mb-0" id="usuarioModalLabel">Registrar nuevo usuario</h5>
                            <div class="cc-modal-subtitle">Complet&aacute; los datos de la cuenta</div>
                        </div>
                    </div>
                    <button type="button" class="hd-modal-close" data-bs-dismiss="modal" aria-label="Cerrar">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <div class="modal-body pt-3">
                    <input type="text" id="IdUsuario" hidden />

                    <label class="form-label usuarios-modal-label" for="Usuario">Usuario</label>
                    <input type="text" id="Usuario" class="form-control usuarios-modal-input" />

                    <label class="form-label usuarios-modal-label mt-3" for="Nombre">Nombre</label>
                    <input type="text" id="Nombre" class="form-control usuarios-modal-input" />

                    <label class="form-label usuarios-modal-label mt-3" for="Apellido">Apellido</label>
                    <input type="text" id="Apellido" class="form-control usuarios-modal-input" />

                    <label class="form-label usuarios-modal-label mt-3" for="Dni">Dni</label>
                    <input type="text" id="Dni" class="form-control usuarios-modal-input" />

                    <label class="form-label usuarios-modal-label mt-3" for="Telefono">Telefono</label>
                    <input type="text" id="Telefono" class="form-control usuarios-modal-input" />

                    <label class="form-label usuarios-modal-label mt-3" for="Direccion">Direccion</label>
                    <input type="text" id="Direccion" class="form-control usuarios-modal-input" />

                    <label class="form-label usuarios-modal-label mt-3" for="TipoNegocio">Tipo de negocio</label>
                    <select id="TipoNegocio" name="select" class="form-select usuarios-modal-select select-modal-personalizado">
                        <option value="0" selected>Seleccione tipo de negocio</option>
                    </select>

                    <label class="form-label usuarios-modal-label mt-3" for="Rol">Rol</label>
                    <select id="Rol" name="select" class="form-select usuarios-modal-select select-modal-personalizado">
                        <option value="0" selected>Seleccione rol</option>
                    </select>

                    <label class="form-label usuarios-modal-label mt-3" for="Contrasena">Contrase&ntilde;a</label>
                    <div class="usuarios-password-wrap">
                        <input id="Contrasena" class="form-control usuarios-modal-input" type="password" placeholder="Contrase&ntilde;a" />
                        <button type="button" class="usuarios-show-password" onclick="togglePassword()" title="Mostrar / ocultar">
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>

                    <label id="lblEstados" class="form-label usuarios-modal-label mt-3" hidden>Estado</label>
                    <select id="Estado" name="select" class="form-select usuarios-modal-select select-modal-personalizado mt-3" hidden>
                        <option value="" selected>Seleccione estado</option>
                    </select>
                </div>
                <p id="datos" class="mb-0 px-3 text-center text-danger datos-error d-none"></p>
                <div class="modal-footer border-0 usuarios-modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cerrar</button>
                    <button id="btnRegistrarModificar" type="button" class="btn btn-primary" onclick="AccionBtn()"></button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Content/Datatable/js/jquery.dataTables.min.js"></script>
    <script src="~/JavaScript/Utils/Utils.js?v=3.14"></script>
    <script src="~/JavaScript/Usuarios.js?v=2.5"></script>
}
