@{
    ViewBag.Title = "Productos";
}

<link href="~/Content/Datatable/css/jquery.dataTables.min.css" rel="stylesheet" />
<link href="~/Content/Datatable/css/responsive.dataTables.min.css" rel="stylesheet" />
<link href="~/Estilos/redisenopantallas.css?v=4.0" rel="stylesheet" />
<link href="~/Estilos/Productos.css?v=4.1" rel="stylesheet" />
<link href="~/Content/font-awesome.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />

<div class="ve-dark prod-root">

    @if (ViewData["ErrorPermisos"] == null)
    {
        <div class="container page-99 py-3">
            <section class="cc-header mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="cc-badge"><i class="fa fa-cubes"></i></div>
                        <div>
                            <h2 class="m-0 fw-800">Productos</h2>
                            <div class="text-muted-cc">Catalogo, caracteristicas, financiacion y envio por WhatsApp</div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 prod-toolbar-actions">
                        <div class="dropdown">
                            <button class="btn btn-outline-light dropdown-toggle" type="button" id="dropdownColumnas" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fa fa-cog me-1"></i> Config. columnas
                            </button>
                            <ul class="dropdown-menu dropdown-menu-right cc-dropdown-menu" id="configColumnasMenu"></ul>
                        </div>
                        <a id="btnStockGeneral" class="btn btn-outline-info" onclick="abrirstockGeneral()"><i class="fa fa-archive me-1"></i> Stock General</a>
                        <a id="btnImportarDatos" class="btn btn-outline-success" onclick="abrirmodalimportacionmasiva()" hidden><i class="fa fa-upload me-1"></i> Importar</a>
                        <a id="btnNuevo" class="btn btn-primary" onclick="abrirmodal()" hidden><i class="fa fa-plus me-1"></i> Nuevo</a>
                    </div>
                </div>
            </section>

            <div class="prod-kpi mb-3" id="divStock" hidden>
                <span>Dinero en stock: </span><span id="precioventa">0</span>
            </div>

            <section class="card-glass p-3 mb-3 prod-table-panel">
                <div class="prod-table-wrap dt-dark-wrap">
                    <table class="display nowrap w-100 dt-dark" id="grdProductos">
                        <thead>
                            <tr>
                                <th class="text-center">Imagen</th>
                                <th class="text-center">Nombre</th>
                                <th class="text-center">Stock</th>
                                <th class="text-center">Precio Compra</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Precio Venta</th>
                                <th class="text-center">Porc. Venta</th>
                                <th class="text-center">Dias Vencimiento</th>
                                <th class="text-center">Activo</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>
        </div>
    }
    else
    {
        <div class="container page-99 py-5 text-center">
            <h2 class="text-danger">Error: No tienes permisos para acceder a esta pantalla</h2>
        </div>
    }
</div>

<!-- Modal producto -->
<div class="modal fade prod-modal-shell" id="productoModal" tabindex="-1" aria-labelledby="productoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="prod-modal-icon"><i class="fa fa-cube"></i></div>
                    <h5 class="modal-title fw-bold text-white mb-0" id="productoModalLabel">Registrar nuevo producto</h5>
                </div>
            </div>
            <div class="modal-body">
                <input type="hidden" id="IdProducto" />
                <input type="hidden" id="imgProd" />

                <ul class="nav nav-tabs prod-tabs mb-3" role="tablist">
                    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabProdGeneral">General</a></li>
                    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabProdCaract">Características</a></li>
                    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabProdFin">Financiación</a></li>
                    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabProdFotos">Fotos</a></li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tabProdGeneral">
                        <div class="row g-3">
                            <div class="col-md-12"><label class="prod-field-label" for="Nombre">Nombre</label><input type="text" id="Nombre" class="form-control form-control-sm prod-field-input" /></div>
                            <div class="col-md-4"><label class="prod-field-label" for="Stock">Stock</label><input type="text" id="Stock" class="form-control form-control-sm prod-field-input miles" /></div>
                            <div class="col-md-4"><label class="prod-field-label" for="DiasVencimiento">Días vencimiento</label><input type="text" id="DiasVencimiento" class="form-control form-control-sm prod-field-input miles" /></div>
                            <div class="col-md-4"><label class="prod-field-label" for="PrecioCompra">P. Compra</label><input type="text" id="PrecioCompra" class="form-control form-control-sm prod-field-input miles" /></div>
                            <div class="col-md-4"><label class="prod-field-label" for="PrecioVenta">P. Venta</label><input type="text" id="PrecioVenta" class="form-control form-control-sm prod-field-input miles" /></div>
                            <div class="col-md-4"><label class="prod-field-label" for="PorcVenta">% Venta</label><input type="text" id="PorcVenta" class="form-control form-control-sm prod-field-input miles" /></div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tabProdCaract">
                        <p class="prod-hint mb-3">Todo lo que sale en el WhatsApp del producto. Completá lo que necesites: detalles fijos, texto comercial y lista con ✔.</p>
                        <div class="row g-3">
                            <div class="col-md-3"><label class="prod-field-label" for="Marca">Marca</label><input type="text" id="Marca" class="form-control form-control-sm prod-field-input" /></div>
                            <div class="col-md-3"><label class="prod-field-label" for="Modelo">Modelo</label><input type="text" id="Modelo" class="form-control form-control-sm prod-field-input" /></div>
                            <div class="col-md-3"><label class="prod-field-label" for="Color">Color</label><input type="text" id="Color" class="form-control form-control-sm prod-field-input" /></div>
                            <div class="col-md-3"><label class="prod-field-label" for="Accesorios">Accesorios / incluye</label><input type="text" id="Accesorios" class="form-control form-control-sm prod-field-input" placeholder="Control remoto, cable HDMI..." /></div>
                            <div class="col-md-6">
                                <label class="prod-field-label" for="Descripcion">Texto comercial</label>
                                <textarea id="Descripcion" class="form-control prod-field-input" rows="5" placeholder="Párrafo de venta: beneficios, uso, por qué elegirlo..."></textarea>
                                <p class="prod-hint mt-1 mb-0">Va primero en el bloque de características del mensaje.</p>
                            </div>
                            <div class="col-md-6">
                                <label class="prod-field-label" for="Caracteristicas">Lista con ✔</label>
                                <textarea id="Caracteristicas" class="form-control prod-field-input" rows="5" placeholder="Una característica por línea&#10;Pantalla 55 pulgadas&#10;Smart TV&#10;4K UHD"></textarea>
                                <p class="prod-hint mt-1 mb-0">Cada línea se muestra con ✔ al enviar.</p>
                            </div>
                            <div class="col-12">
                                <label class="prod-field-label">Vista previa del mensaje WhatsApp</label>
                                <div class="prod-preview-box prod-preview-box--tall" id="previewDescripcion"></div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tabProdFin">
                        <div id="prodCalcModalMount"></div>
                        <p class="prod-hint mb-3 mt-3">Armá el plan con la calculadora. Podés ajustar cada tipo de cuota por separado. «Aplicar todo» completa los campos de abajo.</p>
                        <div class="row g-3">
                            <div class="col-md-6"><label class="prod-field-label" for="FinConEntrega">Con entrega</label><textarea id="FinConEntrega" class="form-control prod-field-input" rows="3"></textarea></div>
                            <div class="col-md-6"><label class="prod-field-label" for="FinSinEntrega">Sin entrega</label><textarea id="FinSinEntrega" class="form-control prod-field-input" rows="3"></textarea></div>
                            <div class="col-md-4"><label class="prod-field-label" for="FinSemanal">Cuotas semanales</label><textarea id="FinSemanal" class="form-control prod-field-input" rows="3"></textarea></div>
                            <div class="col-md-4"><label class="prod-field-label" for="FinQuincenal">Cuotas quincenales</label><textarea id="FinQuincenal" class="form-control prod-field-input" rows="3"></textarea></div>
                            <div class="col-md-4"><label class="prod-field-label" for="FinMensual">Cuotas mensuales</label><textarea id="FinMensual" class="form-control prod-field-input" rows="3"></textarea></div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tabProdFotos">
                        <div class="mb-3">
                            <label class="prod-field-label">Imagen principal</label>
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <img id="imgProducto" src="" class="rounded" style="width: 64px; height: 64px; cursor: pointer; display: none;" onclick="openModal(this.src)" />
                                <input id="Imagen" class="form-control form-control-sm prod-field-input" type="file" accept=".jpg,.jpeg,.png" />
                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="borrarImagen()"><i class="fa fa-trash"></i></button>
                            </div>
                        </div>
                        <div>
                            <label class="prod-field-label">Fotos adicionales (WhatsApp / catálogo)</label>
                            <input id="ImagenesExtraInput" class="form-control form-control-sm prod-field-input mb-2" type="file" accept=".jpg,.jpeg,.png" multiple />
                            <div class="prod-gallery" id="galeriaExtra"></div>
                        </div>
                    </div>
                </div>

                <p id="datosProducto" class="mb-0 mt-3 text-center text-danger datos-error d-none"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cerrar</button>
                <button id="btnRegistrarModificar" type="button" class="btn btn-primary" onclick="AccionBtn()">Registrar</button>
            </div>
        </div>
    </div>
</div>

<!-- WhatsApp -->
<div class="modal fade prod-modal-shell" id="modalWspProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-0 pb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="prod-modal-icon prod-modal-icon--wsp"><i class="fa fa-whatsapp"></i></div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0">Enviar producto por WhatsApp</h5>
                        <div class="prod-hint mt-1">Se abre WhatsApp con el mensaje listo. Las fotos las adjuntás manualmente en el chat.</div>
                    </div>
                </div>
            </div>
            <div class="modal-body prod-wsp-body">
                <input type="hidden" id="wspIdProducto" />

                <div class="prod-wsp-product mb-3">
                    <div class="prod-wsp-product-label">Producto a enviar</div>
                    <div class="prod-wsp-product-name" id="wspNombreProducto"></div>
                </div>

                <div class="prod-wsp-client-bar mb-3">
                    <div class="prod-wsp-client-label">
                        <i class="fa fa-user"></i>
                        <span>Cliente</span>
                    </div>
                    <div class="prod-wsp-client-control">
                        <select id="wspCliente" class="form-select prod-field-input"></select>
                        <button type="button" id="btnWspClienteClear" class="prod-wsp-btn-clear" title="Limpiar cliente">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>
                </div>

                <div class="prod-wsp-field mb-3">
                    <label class="prod-field-label" for="wspTelefono">Celular (sin 0 ni 15)</label>
                    <input type="text" id="wspTelefono" class="form-control prod-field-input" placeholder="Ej: 3512345678" />
                </div>

                <div class="prod-wsp-field mb-3">
                    <label class="prod-field-label" for="wspMensaje">Mensaje (editable)</label>
                    <textarea id="wspMensaje" class="form-control prod-field-input" rows="10"></textarea>
                </div>

                <div class="prod-wsp-field">
                    <label class="prod-field-label">Fotos de referencia (adjuntar manualmente en WhatsApp)</label>
                    <div class="prod-gallery prod-wsp-gallery" id="wspGaleriaPreview"></div>
                </div>
            </div>
            <div class="modal-footer prod-wsp-footer border-0">
                <div class="prod-wsp-footer-actions">
                    <button id="btnCerrarWspProducto"
                            type="button"
                            class="btn btn-outline-light prod-wsp-btn-footer"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>

                    <button id="btnEnviarWspProducto"
                            type="button"
                            class="btn btn-wsp prod-wsp-btn-footer"
                            onclick="enviarWhatsappProducto()">
                        <i class="fa fa-whatsapp me-1"></i>
                        <span>Abrir WhatsApp</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade prod-modal-shell" id="imageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0"><h5 class="modal-title text-white">Imagen ampliada</h5></div>
            <div class="modal-body text-center"><img id="modalImage" src="" class="img-fluid rounded" alt="" /></div>
            <div class="modal-footer border-0"><button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cerrar</button></div>
        </div>
    </div>
</div>

<div class="modal fade prod-modal-shell centered-modal-importar" id="modalImportacionMasiva" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0"><h5 class="modal-title text-white">Importación masiva</h5></div>
            <div class="modal-body"><input id="fileImportacionMasiva" type="file" accept=".xlsx" class="form-control prod-field-input" /></div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="enviarImportacionMasiva()">Importar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade prod-modal-shell" id="nuevoStockModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0"><h5 class="modal-title text-white" id="nuevoStockModalLabel">Editar stock</h5></div>
            <div class="modal-body">
                <input type="hidden" id="IdProductoStock" />
                <input type="text" id="ProductoStock" class="form-control prod-field-input mb-2" disabled />
                <label class="prod-field-label">Cantidad actual</label>
                <input type="text" id="CantidadStock" class="form-control prod-field-input mb-3 miles" disabled />
                <label class="prod-field-label" id="lblAgregarQuitar">Agregar / Quitar</label>
                <div class="d-flex justify-content-center align-items-center gap-2">
                    <button type="button" id="btnQuitar" class="btn btn-danger" onclick="restarStockCantidad()">Quitar</button>
                    <input type="text" id="CantidadNuevaStock" value="1" class="form-control prod-field-input text-center miles" style="max-width: 100px;" />
                    <button type="button" id="btnAgregar" class="btn btn-success" onclick="agregarStockCantidad()">Agregar</button>
                </div>
            </div>
            <div class="modal-footer border-0"><button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cerrar</button></div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Content/Datatable/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/Datatable/js/dataTables.responsive.min.js"></script>
    <script src="~/Scripts/xlsx.full.min.js.js"></script>
    <script src="~/JavaScript/Utils/Utils.js?v=3.14"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <script src="~/JavaScript/Productos.js?v=5.5"></script>
}
