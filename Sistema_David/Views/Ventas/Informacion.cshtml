@{
    ViewBag.Title = "Información de Ventas";
    var qClienteId = Request["clienteId"];
    var qVentaId = Request["ventaId"];
    var qModo = Request["modo"];
    var qFrom = Request["from"];
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
<link href="~/Estilos/bootstrap.min.css" rel="stylesheet" />
<link href="~/Estilos/RedisenoPantallas.css?v=4.0" rel="stylesheet" />
<link href="~/Estilos/InformacionVenta.css?v=30" rel="stylesheet" />

<div class="ve-dark info-ventas-root"
     id="infoVentasApp"
     data-cliente-id="@qClienteId"
     data-venta-id="@qVentaId"
     data-tipo="@Request["tipo"]"
     data-modo="@qModo"
     data-from="@qFrom">

    <div class="container-fluid page-99 iv-page">

        <section class="cc-header iv-hero">
            <div class="iv-hero-main">
                <div class="iv-hero-id">
                    <div class="cc-badge iv-badge">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <div class="iv-hero-titles">
                        <p class="iv-kicker">Información de ventas</p>
                        <h1 class="iv-client" id="clienteNombreTop">—</h1>
                        <p class="iv-sub">Productos, cobros, intereses e historial del cliente</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(qFrom) && qFrom.ToLower() == "cobranzas")
                {
                    <div class="origin-pill">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Origen: Cobranzas</span>
                    </div>
                }
            </div>

            <div class="iv-tools">
                <label class="iv-switch saldadas-toolbar" id="switchSaldadasWrap" title="Mostrar también ventas saldadas">
                    <input class="form-check-input" type="checkbox" role="switch" id="swSaldadas">
                    <span class="iv-switch-copy">
                        <span class="iv-switch-title">Mostrar saldadas</span>
                        <span id="swStats" class="sw-stats-pill"></span>
                    </span>
                </label>

                <div class="iv-actions topbar-actions">
                    <button type="button" id="btnExportPdf" class="iv-btn iv-btn-ok">
                        <i class="bi bi-filetype-pdf"></i>
                        <span>PDF</span>
                    </button>

                    <button type="button" id="btnRefrescar" class="iv-btn iv-btn-ghost">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Refrescar</span>
                    </button>

                    <a class="iv-btn iv-btn-ghost" href="javascript:history.back()">
                        <i class="bi bi-arrow-left"></i>
                        <span>Volver</span>
                    </a>
                </div>
            </div>
        </section>

        <div class="iv-kpis" id="ivKpis" hidden>
            <article class="iv-kpi">
                <span>Ventas</span>
                <b id="kpiCount">0</b>
            </article>
            <article class="iv-kpi iv-kpi-ok">
                <span>Cobrado</span>
                <b id="kpiCobrado">$ 0</b>
            </article>
            <article class="iv-kpi iv-kpi-warn">
                <span>Restante</span>
                <b id="kpiRestante">$ 0</b>
            </article>
            <article class="iv-kpi">
                <span>Total</span>
                <b id="kpiTotal">$ 0</b>
            </article>
        </div>

        <div id="ventasAccordion" class="ventas-accordion iv-list">
            <div class="empty-ventas-box" id="emptyState">
                <div class="empty-ventas-icon"><i class="bi bi-receipt-cutoff"></i></div>
                <div class="empty-ventas-title">Sin ventas</div>
                <div class="empty-ventas-text">No se encontraron ventas para este cliente</div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: Agregar interés -->
<div class="modal fade" id="interesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-mobile">
        <div class="modal-content cobranza-modal">
            <div class="modal-header cobranza-header">
                <h5 class="modal-title">
                    <i class="bi bi-percent me-2"></i>
                    Agregar interés
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form class="row g-3" id="formInteres">
                    <input type="hidden" id="Int_IdVenta" />

                    <div class="col-12 col-md-6">
                        <label class="form-label small">Importe del interés</label>
                        <input type="text" id="Int_Valor" class="form-control form-control-sm iv-input" value="0" inputmode="decimal" />
                        <div class="form-text">Usá puntos para miles (ej: 10.000)</div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label small">Tipo de interés</label>
                        <select id="Int_Tipo" class="form-select form-select-sm iv-input">
                            <option value="">Seleccionar</option>
                            <option value="VISITA CON CAMBIO">VISITA CON CAMBIO</option>
                            <option value="INTERES DE 30 DIAS">INTERES DE 30 DIAS</option>
                            <option value="INTERES DE 60 DIAS">INTERES DE 60 DIAS</option>
                            <option value="PROMESA DE PAGO">PROMESA DE PAGO</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label small">Observación (opcional)</label>
                        <input type="text" id="Int_Obs" class="form-control form-control-sm iv-input" />
                    </div>

                    <div id="Int_Errores" class="alert alert-danger d-none"></div>
                </form>
            </div>

            <div class="modal-footer cobranza-footer">
                <button type="button" class="iv-btn iv-btn-ghost" data-bs-dismiss="modal">Cerrar</button>
                <button id="btnGuardarInteres" type="button" class="iv-btn iv-btn-primary">
                    <i class="bi bi-check2-circle"></i>
                    Guardar interés
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.18.1/moment.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.2/jspdf.min.js"></script>

<script src="~/JavaScript/InformacionVenta.js?v=5.1"></script>
