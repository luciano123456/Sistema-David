<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8">
    <title>My favorite book</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/Estilos/NavBarLogin.css?v=2.2" rel="stylesheet" />
    <link href="~/Content/font-awesome.css" rel="stylesheet" />

    <style>
        .pointer {
            cursor: pointer;
        }

        .select-tipo:hover {
            background: rgba(0,123,255,0.1);
        }
    </style>
</head>

<body>
@{
    var navSesion = Sistema_David.Helpers.SessionHelper.GetUsuarioSesion();
    var navRol = (navSesion != null && navSesion.IdRol.HasValue) ? navSesion.IdRol.Value : 0;
    var navVeProductos = navRol == 1 || navRol == 4;
}

    <nav class="navbar navbar-expand-xl dg-navbar">
        <div class="container-fluid dg-nav-bar">

            <a class="navbar-brand dg-brand">
                <span class="dg-mark" aria-hidden="true">DG</span>
                <span class="dg-brand-copy">
                    <span class="dg-brand-title">Indumentaria DG</span>
                    <span class="dg-brand-sub" id="dgMarcaModo">Indumentaria</span>
                </span>
            </a>

            <div class="dg-nav-tools">
                <div class="dg-alerts">
                    <div id="divNotificacionComprobante" class="dg-alert" hidden title="Comprobantes">
                        <i class="fa fa-print" aria-hidden="true"></i>
                        <span id="notificacionComprobante" class="dg-alert-count is-zero">0</span>
                    </div>
                    <div id="divNotificacionHome" class="dg-alert" hidden title="Clientes ausentes">
                        <i class="fa fa-home" aria-hidden="true"></i>
                        <span id="notificationHome" class="dg-alert-count is-zero">0</span>
                    </div>
                </div>

                <button class="navbar-toggler dg-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">

                <ul class="navbar-nav dg-nav-links me-auto">

                    <li class="nav-item" id="seccionUsuarios" hidden>
                        <a class="nav-link" id="btnUsuarios" onclick="document.location.href='@Url.Content("~/Usuarios/Index/")'">
                            <span class="dg-ico"><i class="fa fa-users"></i></span>
                            <span class="dg-label">Usuarios</span>
                            <span id="notificationStock" class="dg-pill" hidden></span>
                        </a>
                    </li>

                    <li class="nav-item" id="seccionSueldos" hidden>
                        <a class="nav-link" id="btnSueldos" onclick="document.location.href='@Url.Content("~/Pagos/Index/")'">
                            <span class="dg-ico"><i class="fa fa-money"></i></span>
                            <span class="dg-label">Pagos de Sueldos</span>
                        </a>
                    </li>

                    <li class="nav-item" id="seccionRendimiento" hidden>
                        <a class="nav-link" id="btnRendimiento" onclick="document.location.href='@Url.Content("~/Rendimiento/Index/")'">
                            <span class="dg-ico"><i class="fa fa-line-chart"></i></span>
                            <span class="dg-label">Rendimiento</span>
                        </a>
                    </li>

                    <li class="nav-item" id="seccionProductos" @Html.Raw(navVeProductos ? "" : "hidden")>
                        <a class="nav-link" id="btnProductos" onclick="document.location.href='@Url.Content("~/Productos/Index/")'">
                            <span class="dg-ico"><i class="fa fa-cube"></i></span>
                            <span class="dg-label">Productos</span>
                            <span id="badgeProdPendientes" class="dg-pill dg-pill-warn" hidden></span>
                        </a>
                    </li>

                    <li class="nav-item" id="seccionVentas">
                        <a class="nav-link pointer" id="btnVentasGeneral">
                            <span class="dg-ico"><i class="fa fa-shopping-cart"></i></span>
                            <span class="dg-label">Ventas</span>
                        </a>
                    </li>

                    <li class="nav-item" id="seccionCobranzas">
                        <a class="nav-link pointer" id="btnCobranzasGeneral">
                            <span class="dg-ico"><i class="fa fa-credit-card"></i></span>
                            <span class="dg-label">Cobranzas</span>
                        </a>
                    </li>

                    <li class="nav-item" id="seccionStock" hidden>
                        <a class="nav-link" id="btnStock"
                           onclick="document.location.href='@Url.Content("~/Stock/Index/")'">
                            <span class="dg-ico"><i class="fa fa-archive"></i></span>
                            <span class="dg-label">Stock</span>
                        </a>
                    </li>

                    <li class="nav-item" id="seccionClientes" hidden>
                        <a class="nav-link" id="btnClientes" onclick="document.location.href='@Url.Content("~/Clientes/Index/")'">
                            <span class="dg-ico"><i class="fa fa-address-book"></i></span>
                            <span class="dg-label">Clientes</span>
                        </a>
                    </li>

                    <li class="nav-item" id="seccionClientesCero" hidden>
                        <a class="nav-link" id="btnClientesCero" onclick="document.location.href='@Url.Content("~/ClientesCero/Index/")'">
                            <span class="dg-ico"><i class="fa fa-bell"></i></span>
                            <span class="dg-label">Clientes</span>
                            <i id="notificationIcon" class="fa fa-bell dg-bell" style="display:none;"></i>
                        </a>
                    </li>

                    <li class="nav-item dropdown" id="seccionSoporte" hidden>
                        <a class="nav-link dropdown-toggle" href="#" id="configDropdownLink" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="dg-ico"><i class="fa fa-life-ring"></i></span>
                            <span class="dg-label">Soporte</span>
                        </a>
                        <ul class="dropdown-menu dg-menu" aria-labelledby="configDropdownLink">
                            <li>
                                <a class="dropdown-item" href="https://wa.me/5493777710884">
                                    <i class="fa fa-whatsapp text-success"></i> Contactar via WhatsApp
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="tel:+5493777710884">
                                    <i class="fa fa-phone text-danger"></i> Llamar a Soporte
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-item dg-mode-item" id="divbtnCambiarTipoVentas">
                        <a class="nav-link pointer dg-mode-btn" id="btnCambiarTipoVentas">
                            <span class="dg-ico"><i class="fa fa-exchange"></i></span>
                            <span class="dg-mode-copy">
                                <span class="dg-mode-kicker">Sistema</span>
                                <span id="txtModoVenta">Indumentaria</span>
                            </span>
                            <i class="fa fa-angle-down dg-mode-caret"></i>
                        </a>
                    </li>

                </ul>

                <ul class="navbar-nav dg-user-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle dg-user-btn" href="#" id="userDropdown"
                           role="button" data-bs-toggle="dropdown">
                            <span class="dg-avatar" id="dgAvatarLetra" aria-hidden="true">U</span>
                            <span id="userName" class="dg-user-name"></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end dg-menu">
                            <li>
                                <a class="dropdown-item" onclick="cerrarSession();">
                                    <i class="fa fa-sign-out"></i> Cerrar sesión
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>

            </div>
        </div>
    </nav>


    <!-- 🔥 MODAL PARA ELEGIR TIPO DE VENTA -->
    <div class="modal fade" id="modalTipoVentas" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content modal-tipo-ventas border-0">

                <!-- HEADER -->
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-semibold text-white">
                        Seleccionar tipo de ventas
                    </h5>
                </div>

                <!-- BODY -->
                <div class="modal-body text-center pt-2">

                    <p class="text-light opacity-75 mb-4 small">
                        Elegí el sistema con el que vas a trabajar
                    </p>

                    <div class="row g-4">

                        <!-- INDUMENTARIA -->
                        <div class="col-12 col-md-6">
                            <div class="select-tipo tipo-card tipo-indumentaria" data-tipo="indumentaria">
                                <div class="tipo-icon bg-success">
                                    <i class="fa fa-shopping-bag"></i>
                                </div>
                                <h6>Indumentaria</h6>
                                <span>Ventas rápidas</span>
                            </div>
                        </div>

                        <!-- ELECTRO -->
                        <div class="col-12 col-md-6">
                            <div class="select-tipo tipo-card tipo-electro" data-tipo="electro">
                                <div class="tipo-icon bg-primary">
                                    <i class="fa fa-television"></i>
                                </div>
                                <h6>Electrodomésticos</h6>
                                <span>Ventas financiadas</span>
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>
    <script src="~/JavaScript/Utils/Utils.js?v=3.19"></script>
    <script src="~/JavaScript/NavBarLogin.js?v=3.1"></script>

</body>
</html>
