@{
    ViewData["Title"] = "DG — Acceso";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Estilos/Login.css?v=6.3" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="~/Imagenes/LogoDG.svg" />
</head>
<body>

    @using System.Configuration
    @{
        bool ambienteTest = ConfigurationManager.AppSettings["AmbienteTest"] == "1";
    }

    @if (ambienteTest)
    {
        <div class="wm-test-pattern" aria-hidden="true"></div>
    }

    <div class="lx-scene" aria-hidden="true">
        <div class="lx-beam lx-beam--1"></div>
        <div class="lx-beam lx-beam--2"></div>
        <div class="lx-orb lx-orb--1"></div>
        <div class="lx-orb lx-orb--2"></div>
        <div class="lx-ring"></div>
        <div class="lx-ring lx-ring--2"></div>
        <div class="lx-noise"></div>
    </div>

    <main class="lx">
        <div class="lx-card">
            <svg class="lx-card__trace" viewBox="0 0 440 560" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                    <linearGradient id="lxTraceGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#22d3ee"/>
                        <stop offset="35%" stop-color="#4c7dff"/>
                        <stop offset="65%" stop-color="#a78bfa"/>
                        <stop offset="100%" stop-color="#f472b6"/>
                    </linearGradient>
                    <filter id="lxTraceGlow" x="-40%" y="-40%" width="180%" height="180%">
                        <feGaussianBlur stdDeviation="2" result="b"/>
                        <feMerge>
                            <feMergeNode in="b"/>
                            <feMergeNode in="SourceGraphic"/>
                        </feMerge>
                    </filter>
                </defs>
                <!-- rx=28 igual que --radius del card; trazo pegado al borde -->
                <rect class="lx-card__trace-run" x="2" y="2" width="436" height="556" rx="28" ry="28" pathLength="100"/>
            </svg>

            <div class="lx-brand">
                <span class="lx-mark">DG</span>
            </div>

            <header class="lx-head">
                <h1>Iniciar sesión</h1>
                <p>Usuario y contraseña del sistema</p>
            </header>

            <form id="loginForm" class="lx-form" autocomplete="on" novalidate>
                <div class="lx-field">
                    <label for="username">Usuario</label>
                    <div class="lx-control">
                        <input type="text"
                               class="login-input"
                               id="username"
                               name="username"
                               autocomplete="username"
                               placeholder=" "
                               required>
                        <span class="lx-placeholder" aria-hidden="true">Tu usuario</span>
                    </div>
                </div>

                <div class="lx-field">
                    <label for="password">Contraseña</label>
                    <div class="lx-control">
                        <input type="password"
                               class="login-input"
                               id="password"
                               name="password"
                               autocomplete="current-password"
                               placeholder=" "
                               required>
                        <span class="lx-placeholder" aria-hidden="true">Tu contraseña</span>
                        <button type="button" class="password-toggle" id="togglePassword" aria-label="Mostrar u ocultar contraseña">
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="lx-row">
                    <label class="remember" for="rememberMe">
                        <input type="checkbox" id="rememberMe">
                        <span class="remember__box" aria-hidden="true"><i class="fa fa-check"></i></span>
                        <span>Recordarme</span>
                    </label>
                    <i id="checkIcon" class="fa fa-check-circle remember-ok" style="display: none;" aria-hidden="true"></i>
                </div>

                <div id="diverrorMessage" class="login-alert" role="alert" style="display: none;">
                    <i class="fa fa-exclamation-circle" aria-hidden="true"></i>
                    <span id="errorMessage"></span>
                </div>

                <button type="submit" class="login-btn">
                    <span class="login-btn__label">Ingresar</span>
                </button>
            </form>
        </div>
    </main>

    <img id="loginLogo" src="~/Imagenes/LogoDG.svg" alt="" hidden>

    <script>
        var loginUrl = '@Url.Action("Login_User", "Login")';
    </script>
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/JavaScript/Login.js?v=6.0"></script>
</body>
</html>
